    <script>
         let currentpage =<%= currentPage%>;
        let totalpages = <%= totalPages%>;
        let maxData=<%= pageSize %>;
        let pages=to/maxData;
        
      const data=  document.getElementById('data');
       const page= document.getElementById('currentpage');
       
       

       function updateButton() {
        document.getElementById('currentpage').innerHTML=`  ${currentPage}`;
        document.getElementById("currentNext").innerHTML=` ${currentPage+1}`;
        document.getElementById("currentNextSecond").innerHTML=`  ${currentPage+2}`;
        document.getElementById("currentNextThird").innerHTML=` ${currentPage+3}`;
        document.getElementById("context").innerHTML=`Page ${currentPage}`
       }

       function nextPage() {
       if (currentpage<pages) {
             currentpage++;
            updateButton();
            
        }
        
       }
       function previousPage() {
        if (currentpage>1) {
            currentpage--;
            updateButton();
        }   
       }
       function navigateTopage(page) {
        if (page>=1 && pageNumber <=totalpages) {
             window.location.href = `/?page=${pageNumber}`;
        }
        
       }
      
   function jumpToPage(pageNumber) {
    if (pageNumber >= 1 && pageNumber <= totalpages) {
        currentpage = pageNumber;
        updateButton();
         
    }
}

       updateButton();
    </script>
