const mysql=require('mysql2');
const connection=mysql.createConnection({
    host:"localhost",
    user:"root",
    password:"Dev@123",
    database:"student_details"
});

connection.connect((err)=>{
    if (err) {
        console.log("Database connection failed");
        return;   
    }

    console.log("Connect to Mysql database");
    
});
module.exports=connection;


const express = require("express");
const app = express();
const db = require("./db");
require('dotenv').config();

app.set("view engine", "ejs");
app.use(express.json());

const totalDataSize = process.env.TOTAL_DATA_SIZE;
const pageSize = parseInt(process.env.PAGE_LIMIT);  
const totalPages = Math.ceil(totalDataSize / pageSize);

app.get("/", (req,res)=>{

    let currentPage=parseInt(req.query.page)||1;
    let sort=req.query.sort||"studentid";
    let order=req.query.order||"ASC";
    let search=req.query.search||"";
    
    const offset=(currentPage-1)*pageSize;
    
    let query=`
    SELECT * FROM students
    WHERE fname LIKE ?
    ORDER BY ${sort} ${order}
    LIMIT ? OFFSET ?
    `;
    
    db.query(query,[`%${search}%`,pageSize,offset],(err,results)=>{
    
    if(err){
    console.log(err);
    return res.send("Database error");
    }
    
    res.render("pagination",{
    students:results,
    currentPage,
    totalPages,
    sort,
    order,
    search
    });
    
    });
    
    });
app.listen(3000, () => {
    console.log("Server listening at port 3000");
});
